<!-- MyoSkeleton for mjlab (scene handled by framework). -->
<mujoco model="MyoSkeleton">

	<include file="./assets/myoskeleton_assets.xml"/>

	<worldbody>
		<body name="myoskeleton_root" pos="0 0 .95">
			<freejoint name="myoskeleton_root"/>
			<include file="./assets/myoskeleton_chain.xml"/>
		</body>
	</worldbody>
	<sensor>
		<subtreeangmom name="root_angmom" body="myoskeleton_root"/>
	</sensor>

</mujoco>
